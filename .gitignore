# .gitignore

# Exclude virtual environment
venv/
old/

# Exclude notes1.md
notes1.md
notes.md

# Exclude specific Python files
main2.py

# Exclude all __pycache__ directories
# __pycache__/

# Exclude any compiled Python files
*.pyc
*.pyo
*.pyd

# Exclude local configuration files
*.env

# Exclude logs and other temporary files
*.log
*.tmp

# Exclude database files
*.db
*.db-shm
*.db-wal
*.sqlite

# Exclude IDE and editor-specific files
.idea/
.vscode/

# Exclude compiled files from web frameworks
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
env/
.venv/
assets/.webview_data/
desktop/.webview_data/
desktop/dist/

# Exclude local machine shortcuts and launchers
*.lnk
Launch *.vbs
Launch *.bat
desktop/shortcuts/*.lnk
desktop/shortcuts/*.vbs
desktop/shortcuts/*.bat

# Exclude compiled JavaScript files
node_modules/
dist/


