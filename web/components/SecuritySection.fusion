<template>
  <section id="section-security" class="tab-section hidden space-y-8">
    <div class="text-center max-w-2xl mx-auto">
      <span class="badge badge-warning badge-outline mb-2">Desktop &amp; Android App Builder • OWASP Top 10 • CLI</span>
      <h2 class="text-3xl font-bold">{{ heading }}</h2>
      <p class="text-sm opacity-75 mt-2">
        Customize your Project Name, Window Title, and Icon (<code>pyfusion.json</code>), save a Desktop App Shortcut (<code>.lnk</code>), build Android <code>.APK</code> / <code>.AAB</code> packages, and inspect OWASP protections.
      </p>
    </div>

    <!-- Reactive Project Name, Icon & Hybrid App Studio Card -->
    <div class="card bg-base-100 border border-indigo-500/30 shadow-xl">
      <div class="card-body">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-3">
            <img src="/assets/logo.png" alt="Project Icon" class="w-10 h-10 object-contain rounded-lg bg-base-200 p-1" />
            <div>
              <h3 class="card-title text-lg">⚙️ Project Name, Icon &amp; Hybrid App Builder</h3>
              <p class="text-xs opacity-70">Persists to root <code>pyfusion.json</code> and generates <code>desktop/icons/icon.ico</code>, <code>desktop/shortcuts/</code> &amp; <code>mobile/buildozer.spec</code></p>
            </div>
          </div>
          <span class="badge badge-success badge-outline">{{ studio_status }}</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="form-control">
            <label class="label"><span class="label-text text-xs font-semibold">Project Name (Package / .exe Name)</span></label>
            <input type="text" f-model="project_name" class="input input-bordered input-sm w-full" />
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text text-xs font-semibold">Desktop Window &amp; Shortcut Title</span></label>
            <input type="text" f-model="app_title" class="input input-bordered input-sm w-full" />
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text text-xs font-semibold">Project Icon Path (.png or .ico)</span></label>
            <input type="text" f-model="icon" class="input input-bordered input-sm w-full" />
          </div>
        </div>

        <div class="card-actions justify-end mt-4 gap-2 flex-wrap">
          <button @click="save_config" class="btn btn-sm btn-outline">💾 Save Name &amp; Icon</button>
          <button @click="save_desktop" class="btn btn-sm bg-emerald-600 hover:bg-emerald-500 text-white border-none">
            🖥️ Save Desktop App Shortcut (.lnk)
          </button>
          <button @click="build_apk" class="btn btn-sm bg-indigo-600 hover:bg-indigo-500 text-white border-none">
            📦 Build .APK (Direct Install)
          </button>
          <button @click="build_aab" class="btn btn-sm bg-purple-600 hover:bg-purple-500 text-white border-none">
            🏪 Build .AAB (Play Store)
          </button>
          <button @click="launch_mobile" class="btn btn-sm btn-outline border-emerald-500/40 text-emerald-400">
            🤖 Launch Android Simulator
          </button>
        </div>
      </div>
    </div>

    <!-- Live OWASP Security Audit Card -->
    <div class="card bg-base-100 border border-emerald-500/30 shadow-xl">
      <div class="card-body">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2">
            <span class="text-2xl">🛡️</span>
            <div>
              <h3 class="card-title text-lg">Active OWASP Top 10 Protections</h3>
              <p class="text-xs opacity-70">Live report from <code>GET /api/security/audit</code></p>
            </div>
          </div>
          <a href="/api/security/audit" target="_blank" class="btn btn-xs btn-outline">View Raw JSON ↗</a>
        </div>

        <div id="owasp-audit-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
          <div class="p-3 rounded-lg bg-base-200/70 border border-base-content/10">
            <div class="font-bold text-emerald-400 mb-1">A01: Access Control &amp; Path Traversal</div>
            <p class="opacity-80">Blocks <code>../</code> traversal, dotfiles (<code>.env</code>), and <code>.py</code>/<code>.db</code> exposure; enforces RPC method allowlists.</p>
          </div>
          <div class="p-3 rounded-lg bg-base-200/70 border border-base-content/10">
            <div class="font-bold text-emerald-400 mb-1">A02: Cryptographic Failures</div>
            <p class="opacity-80"><code>hash_password()</code> uses PBKDF2-HMAC-SHA256 (260k iterations) + random salt &amp; constant-time comparison.</p>
          </div>
          <div class="p-3 rounded-lg bg-base-200/70 border border-base-content/10">
            <div class="font-bold text-emerald-400 mb-1">A03: SQLi &amp; XSS Injection</div>
            <p class="opacity-80">100% parameterized SQL statements in <code>FusionDB</code> + SQL identifier validation + automatic HTML escaping.</p>
          </div>
          <div class="p-3 rounded-lg bg-base-200/70 border border-base-content/10">
            <div class="font-bold text-emerald-400 mb-1">A04: Rate Limiting &amp; DoS Protection</div>
            <p class="opacity-80">Sliding-window IP rate limiter (180 req/min) returning <code>429 Retry-After</code> + 2MB max request body size cap.</p>
          </div>
          <div class="p-3 rounded-lg bg-base-200/70 border border-base-content/10">
            <div class="font-bold text-emerald-400 mb-1">A05: Security Headers</div>
            <p class="opacity-80">Injects <code>X-Content-Type-Options: nosniff</code>, <code>X-Frame-Options: SAMEORIGIN</code>, <code>Referrer-Policy</code>, and <code>Permissions-Policy</code>.</p>
          </div>
          <div class="p-3 rounded-lg bg-base-200/70 border border-base-content/10">
            <div class="font-bold text-emerald-400 mb-1">A07: CSRF Token Verification</div>
            <p class="opacity-80">HMAC-SHA256 signed CSRF tokens with <code>SameSite=Lax</code> cookie and automatic <code>X-CSRF-Token</code> RPC header.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- CLI Commands Reference -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="card bg-base-100 border border-base-content/10 shadow p-5 flex flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs opacity-60 mb-1">Scaffold a Database ORM Model</div>
          <code class="text-sm font-bold text-emerald-400">pyfusion create model Product</code>
        </div>
        <button data-copy="pyfusion create model Product" class="btn btn-sm btn-outline">Copy</button>
      </div>

      <div class="card bg-base-100 border border-base-content/10 shadow p-5 flex flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs opacity-60 mb-1">Check or Auto-Migrate Database Tables</div>
          <code class="text-sm font-bold text-indigo-400">pyfusion db migrate</code>
        </div>
        <button data-copy="pyfusion db migrate" class="btn btn-sm btn-outline">Copy</button>
      </div>

      <div class="card bg-base-100 border border-base-content/10 shadow p-5 flex flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs opacity-60 mb-1">Create a Vue-style Single-File Component (.fusion)</div>
          <code class="text-sm font-bold text-emerald-400">pyfusion create component UserCard</code>
        </div>
        <button data-copy="pyfusion create component UserCard" class="btn btn-sm btn-outline">Copy</button>
      </div>

      <div class="card bg-base-100 border border-base-content/10 shadow p-5 flex flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs opacity-60 mb-1">Build Android APK &amp; Play Store AAB</div>
          <code class="text-sm font-bold text-amber-400">pyfusion build android --format both</code>
        </div>
        <button data-copy="pyfusion build android --format both" class="btn btn-sm btn-outline">Copy</button>
      </div>
    </div>
  </section>
</template>

<script>
from fusionlib.config import (
    create_desktop_shortcut,
    ensure_project_ico,
    generate_android_project,
    launch_mobile_detached,
    load_project_config,
    save_project_config,
)

props = {
    "heading": "Project Name, Icon & OWASP Security"
}

# Studio actions write project files and spawn processes: allow them only from localhost in development mode.
restrict_to_localhost = True


def data(self):
    cfg = load_project_config()
    return {
        "project_name": cfg.get("project_name", "PyFusion-Studio"),
        "app_title": cfg.get("app_title", "Uniplexity AI - PyFusion"),
        "icon": cfg.get("icon", "web/assets/logo.png"),
        "studio_status": "Synced with pyfusion.json",
        "toast_message": "",
    }


def _persist(self):
    updates = {
        "project_name": str(self.state.get("project_name") or "PyFusion-Studio").strip(),
        "app_title": str(self.state.get("app_title") or "Uniplexity AI - PyFusion").strip(),
        "icon": str(self.state.get("icon") or "web/assets/logo.png").strip(),
    }
    cfg = save_project_config(updates)
    ensure_project_ico(cfg.get("icon"))
    return cfg


def save_config(self):
    cfg = self._persist()
    self.state.studio_status = f"✓ Saved ({cfg['project_name']})"
    self.state.toast_message = f"Saved project '{cfg['project_name']}' and generated icon.ico!"


def save_desktop(self):
    cfg = self._persist()
    info = create_desktop_shortcut()
    self.state.studio_status = "✓ Desktop Shortcut Created!"
    self.state.toast_message = f"Created Desktop App Shortcut for '{info.get('app_title', cfg['app_title'])}'!"


def build_apk(self):
    self._persist()
    info = generate_android_project(artifact_format="apk")
    self.state.studio_status = f"✓ Android .APK Ready ({info['package_name']})"
    self.state.toast_message = f"Configured Android .APK ({info['package_name']}) in mobile/buildozer.spec!"


def build_aab(self):
    self._persist()
    info = generate_android_project(artifact_format="aab")
    self.state.studio_status = f"✓ Android .AAB Ready ({info['package_name']})"
    self.state.toast_message = f"Configured Play Store .AAB ({info['package_name']}) in mobile/buildozer.spec!"


def launch_mobile(self):
    pid = launch_mobile_detached()
    self.state.studio_status = f"✓ Simulator Running (PID {pid})"
    self.state.toast_message = f"Launched Android Simulator Window (PID: {pid})!"
</script>
